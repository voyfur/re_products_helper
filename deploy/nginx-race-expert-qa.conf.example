# Include limit_req_zone inside nginx's http{} context.
# Replace api.example.com and certificate paths after the VPS operator chooses
# the API hostname and provisions DNS/TLS. This template does not require DNS
# while preparing or handing off the application repository.
limit_req_zone $binary_remote_addr zone=product_qa_edge:10m rate=10r/s;

server {
    listen 80;
    server_name api.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name api.example.com;

    ssl_certificate /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 16k;
    access_log off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /health {
        if ($request_method != GET) { return 405; }
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 145s;
    }

    location = /ready {
        return 404;
    }

    location = /api/v1/ask {
        if ($request_method != POST) { return 405; }
        limit_req zone=product_qa_edge burst=20 nodelay;
        limit_req_status 429;
        error_page 429 = @product_qa_rate_limited;

        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 145s;
    }

    location = /api/v1/ask/stream {
        if ($request_method != POST) { return 405; }
        limit_req zone=product_qa_edge burst=20 nodelay;
        limit_req_status 429;
        error_page 429 = @product_qa_rate_limited;

        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 145s;
    }

    location @product_qa_rate_limited {
        default_type application/json;
        add_header Retry-After 60 always;
        return 429 '{"error":"rate_limited"}';
    }

    location / {
        return 404;
    }
}
