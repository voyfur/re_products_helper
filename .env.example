# Persistent backend example: the direct connector verifies the trusted CA and server identity.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD_FILE=/run/secrets/mysql_password
MYSQL_SSL_CA=/run/secrets/mysql_ca.pem
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# Set TAVILY_API_KEY directly or use TAVILY_API_KEY_FILE, never both.
TAVILY_API_KEY=
# TAVILY_API_KEY_FILE=/run/secrets/tavily_api_key
# Required only when enabling the versioned server-to-server site API.
PRODUCT_QA_API_KEY_FILE=/run/secrets/product_qa_api_key
JOURNAL_PATH=var/qa-journal.sqlite3
